src/dashboard/tabs/tab7_ag_usage.py
src/dashboard/tabs/tab8_ag_quality.py
src/dashboard/tabs/tab9_ag_stats.py

# 관리자 전용 (외부 공개 금지)
src/dashboard/tabs/tab99_admin.py

# 메인 V3 의 dev 폴더 (있다면)
src/dashboard/tabs/_archive/

# 마이그레이션 백업
*.before_migration_260601.bak
*.before_tab99_removal.bak
*.before_disable.bak

# Python 캐시
*.pyc
*.pyo

