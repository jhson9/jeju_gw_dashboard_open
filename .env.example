# ==============================================================================
#  환경변수 설정 파일 (예시)
# ------------------------------------------------------------------------------
#  【사용 방법】
#  1) 이 파일을 복사해서 이름을 ".env" (점으로 시작) 로 바꾸세요.
#     - Windows: 파일 탐색기에서 우클릭 → 복사 → 이름을 .env 로 변경
#     - VS Code에서 직접 생성하면 더 편합니다.
#
#  2) 아래 KMA_API_KEY= 뒤에 실제 API 키를 붙여넣으세요.
#     (따옴표 없이, 공백 없이)
#
#  【API 키 발급 방법】
#  1) 공공데이터포털 접속: https://www.data.go.kr
#  2) 회원가입 / 로그인
#  3) 검색창에 "기상청_지상(종관, ASOS) 일자료 조회서비스" 검색
#  4) "활용신청" 버튼 클릭 → 즉시 승인됨
#  5) 마이페이지 → 개발계정 → 인증키 (Decoding) 복사
#     ※ Encoding 키가 아니라 "Decoding" 키를 사용해야 합니다!
#
#  【주의사항】
#  - .env 파일은 절대로 Git에 업로드하지 마세요.
#    (.gitignore에 이미 등록되어 있습니다)
#  - API 키를 외부에 공개하지 마세요.
# ==============================================================================

# 기상청 ASOS 일자료 조회서비스 API 인증키 (Decoding)
KMA_API_KEY=your_api_key_here

# ------------------------------------------------------------------------------
#  V-World 2D 지도 API 인증키 (공간 분석 탭용 — Build 1.2.01)
#  발급: https://www.vworld.kr → 오픈API → 인증키 발급/관리
#  - 활용 API: ✅ 2D 지도   (필요시 ✅ 좌표변환)
#  - 참조 URL: http://localhost  http://localhost:8501
#  키 미설정 시 OpenStreetMap + ESRI 위성 타일로 자동 폴백.
# ------------------------------------------------------------------------------
VWORLD_API_KEY=your_vworld_api_key_here
